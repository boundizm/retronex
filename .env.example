# Discord Developer Portal -> Bot -> Token
DISCORD_TOKEN=
# Discord Developer Portal -> General Information -> Application ID
CLIENT_ID=
# (Opsiyonel) Doluysa komutlar sadece bu sunucuya anında yüklenir. Boşsa global yüklenir (1 saat sürebilir).
GUILD_ID=

# (Opsiyonel) Varsayılanlar src/config.js içinde tanımlı
# VOICE_HUB_CHANNEL_ID=1555149263925813258
# TICKET_PANEL_CHANNEL_ID=1555279909553709066
# TICKET_CATEGORY_ID=1555279862326104124

# Web paneli (metin düzenleme). PANEL_PASSWORD boşsa panel kapalı.
PANEL_PASSWORD=
# PANEL_PORT=3000
# PANEL_HOST=127.0.0.1
# PANEL_COOKIE_SECURE=false   # HTTPS arkasında true yap
# PANEL_TRUST_PROXY=false     # ters vekil arkasında true yap
